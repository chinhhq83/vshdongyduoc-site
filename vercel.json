{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(images|css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vshdongyduoc.org"
        }
      ],
      "destination": "https://www.vshdongyduoc.org/:path*",
      "permanent": true
    },
    {
      "source": "/kien-thuc/dong-trung-ha-thao/chon-dong-trung-ha-thao-chat-luong",
      "destination": "/kien-thuc/dong-trung-ha-thao/chon-dong-trung-ha-thao",
      "permanent": true
    },
    {
      "source": "/kien-thuc/dong-trung-ha-thao/dong-trung-ha-thao-chua-ung-thu",
      "destination": "/kien-thuc/dong-trung-ha-thao/dong-trung-ha-thao-va-ung-thu",
      "permanent": true
    },
    {
      "source": "/kien-thuc/dong-trung-ha-thao-la-gi",
      "destination": "/kien-thuc/dong-trung-ha-thao/dong-trung-ha-thao-la-gi",
      "permanent": true
    },
    {
      "source": "/kien-thuc/cong-dung-dong-trung-ha-thao",
      "destination": "/kien-thuc/dong-trung-ha-thao/cong-dung-dong-trung-ha-thao",
      "permanent": true
    },
    {
